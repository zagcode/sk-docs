class Components {
  cardLink(link) {
    return `
      <div class="card">
        <span class="z-text-200 font-bold">${link.innerText}</span>
        <svg width="25" height="24" viewBox="0 0 25 24" fill="#008561" xmlns="http://www.w3.org/2000/svg">
          <path fill="#008561"  d="M18.0982 11.6202C18.0506 11.4974 17.9793 11.3853 17.8882 11.2902L12.8882 6.29019C12.795 6.19695 12.6843 6.12299 12.5625 6.07253C12.4407 6.02207 12.3101 5.99609 12.1782 5.99609C11.9119 5.99609 11.6565 6.10188 11.4682 6.29019C11.375 6.38342 11.301 6.49411 11.2506 6.61594C11.2001 6.73776 11.1741 6.86833 11.1741 7.00019C11.1741 7.26649 11.2799 7.52188 11.4682 7.71019L14.7682 11.0002H7.17822C6.91301 11.0002 6.65865 11.1055 6.47112 11.2931C6.28358 11.4806 6.28358 11.735 6.17822 12.0002C6.17822 12.2654 6.28358 12.5198 6.47112 12.7073C6.65865 12.8948 6.91301 13.0002 7.17822 13.0002H14.7682L11.4682 16.2902C11.3745 16.3831 11.3001 16.4937 11.2493 16.6156C11.1986 16.7375 11.1724 16.8682 11.1724 17.0002C11.1724 17.1322 11.1986 17.2629 11.2493 17.3848C11.3001 17.5066 11.3745 17.6172 11.4682 17.7102C11.5612 17.8039 11.6718 17.8783 11.7936 17.9291C11.9155 17.9798 12.0462 18.006 12.1782 18.006C12.3102 18.006 12.4409 17.9798 12.5628 17.9291C12.6847 17.8783 12.7953 17.8039 12.8882 17.7102L17.8882 12.7102C17.9793 12.6151 18.0506 12.5029 18.0982 12.3802C18.1982 12.1367 18.1982 11.8636 18.0982 11.6202Z" fill="currentColor" class="z-text-brand-700" />
        </svg>
      </div>
    `;
  }

  tooltip(text) {
    if(!text) return `<div></div>`;
    
    return `
      <div class="tooltip relative inline-block cursor-pointer ml-2">
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#008561"><path d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
        <div class="tooltiptext absolute z-10 top-full left-0 mt-2 px-2 py-1 text-sm text-white bg-gray-800 rounded shadow-md opacity-0 invisible transition-all duration-200 pointer-events-none text-center">
          <p class="min-w-[300px] max-w-fit">
            ${text}
          </p>
        </div>
      </div>`
  }
}